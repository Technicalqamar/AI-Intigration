PORT=5000
NODE_ENV=development
MONGODB_URI=
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
# Production requires the exact frontend origin; wildcard is local-development only.
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,https://codenestagent.vercel.app
AI_REQUEST_TIMEOUT_MS=20000
AI_RATE_LIMIT_WINDOW_MS=900000
AI_RATE_LIMIT_MAX=10
# Development-only task assistant identity. Must remain disabled in production.
AI_ASSISTANT_DEV_IDENTITY_ENABLED=false
AI_ASSISTANT_DEV_USER_ID=
