          "name": "Generate AI Task Plan (POST /api/ai/plan-task)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Response conforms to Plan schema\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.success).to.be.true;",
                  "    pm.expect(json.plan).to.have.property(\"summary\");",
                  "    pm.expect([\"low\", \"medium\", \"high\"]).to.include(json.plan.priority);",
                  "    pm.expect(json.plan.estimatedHours).to.be.a(\"number\");",
                  "    pm.expect(json.plan.estimatedHours).to.be.above(0);",
                  "    pm.expect(Array.isArray(json.plan.steps)).to.be.true;",
                  "    pm.expect(json.plan.steps.length).to.be.above(0);",
                  "});"
                ],
